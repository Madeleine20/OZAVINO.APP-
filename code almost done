    private void updateDisplay(String page) {
        String h = "images/ban_page1_horitentale.png.png"; 
        String v = "images/ban_page1_verticale.png.png";

        if(page.equals("Catégories")) {
            h = "images/ban_page3_horizontale.png.png";
            v = "images/ban_page3_verticale.png.jpg";
        } else if(page.equals("Compte")) {
            h = "images/ban_page2_horizentale.png.png"; 
            v = "images/ban_page2_verticale.png.png";
        }
        
        try {
            topBanner.setIcon(new ImageIcon(new ImageIcon(h).getImage().getScaledInstance(800, 180, Image.SCALE_SMOOTH)));
            sideBanner.setIcon(new ImageIcon(new ImageIcon(v).getImage().getScaledInstance(160, 580, Image.SCALE_SMOOTH)));
        } catch (Exception e) {}
        
        cardLayout.show(mainContent, page);
    }

    private void traduireApplication() {
        if(langueActuelle.equals("EN")) setTitle("OZAVINO - Universal Library");
        else if(langueActuelle.equals("ES")) setTitle("OZAVINO - Biblioteca Universal");
        else setTitle("OZAVINO - Bibliothèque Universelle");
        
        Component[] components = ((JPanel)((JPanel)getContentPane().getComponent(0)).getComponent(1)).getComponents();
        for (Component comp : components) {
            if (comp instanceof JButton) {
                JButton btn = (JButton) comp;
                String text = btn.getText();
                if (text.equals("Accueil") || text.equals("Home") || text.equals("Inicio")) {
                    btn.setText(t("accueil"));
                } else if (text.equals("Compte") || text.equals("Account") || text.equals("Cuenta")) {
                    btn.setText(t("compte"));
                } else if (text.equals("Catégories") || text.equals("Categories") || text.equals("Categorías")) {
                    btn.setText(t("categories"));
                }
            }
        }
        
        mainContent.removeAll();
        mainContent.add(createPageAccueil(), "Accueil");
        mainContent.add(createPageCategories(), "Catégories");
        mainContent.add(createPageConnexion(), "Connexion");
        mainContent.add(createPageCompte(), "Compte");
        
        cardLayout.show(mainContent, "Accueil");
    }

