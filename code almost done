    private JButton createMenuBtn(String txt, String imgPath, String page) {
        ImageIcon icon = null;
        if (!imgPath.isEmpty()) {
            try {
                icon = new ImageIcon(new ImageIcon(imgPath).getImage().getScaledInstance(50, 50, Image.SCALE_SMOOTH));
            } catch (Exception e) {}
        }
        JButton b = new JButton(txt, icon);
        b.setVerticalTextPosition(SwingConstants.BOTTOM);
        b.setHorizontalTextPosition(SwingConstants.CENTER);
        b.setFont(new Font("Serif", Font.PLAIN, 12));
        b.setForeground(texteClair);
        b.setContentAreaFilled(false);
        b.setBorderPainted(false);
        b.addActionListener(e -> updateDisplay(page));
        return b;
    }

    private String t(String cle) {
        int i = langueActuelle.equals("FR") ? 0 : (langueActuelle.equals("EN") ? 1 : 2);
        return dico.getOrDefault(cle, new String[]{cle, cle, cle})[i];
    }

