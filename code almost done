        buttonPanel.setBounds(200, 650, 500, 60);
        
        JButton modifierBtn = new JButton(t("modifier_infos"));
        modifierBtn.setBackground(argile);
        modifierBtn.setForeground(Color.WHITE);
        modifierBtn.setBorderPainted(false);
        modifierBtn.setFont(new Font("Serif", Font.BOLD, 12));
        modifierBtn.setPreferredSize(new Dimension(200, 40));
        modifierBtn.addActionListener(e -> editerProfil()); // même fonction que le crayon
        
        JButton deconnecterBtn = new JButton(t("deconnecter"));
        deconnecterBtn.setBackground(argile);
        deconnecterBtn.setForeground(Color.WHITE);
        deconnecterBtn.setBorderPainted(false);
        deconnecterBtn.setFont(new Font("Serif", Font.BOLD, 12));
        deconnecterBtn.setPreferredSize(new Dimension(200, 40));
        deconnecterBtn.addActionListener(e -> {
            int confirm = JOptionPane.showConfirmDialog(p, t("confirm_deconnexion"), t("deconnexion"), JOptionPane.YES_NO_OPTION);
