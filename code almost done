    private void addSection(JPanel parent, String titre, String[] items) {
        JLabel t = new JLabel(titre);
        t.setForeground(acacia); 
        t.setFont(new Font("Serif", Font.BOLD, 18));
        parent.add(t);
        parent.add(Box.createVerticalStrut(5));
        
        for (String item : items) {
            JLabel link = new JLabel("• " + item);
            link.setForeground(texteClair);
            link.setFont(new Font("Serif", Font.PLAIN, 13));
            link.setCursor(new Cursor(Cursor.HAND_CURSOR));
            link.addMouseListener(new MouseAdapter() {
                public void mouseClicked(MouseEvent e) {
                    mainContent.add(createPageDetails(item), "Detail_" + item);
                    cardLayout.show(mainContent, "Detail_" + item);
                }
            });
            parent.add(link);
            parent.add(Box.createVerticalStrut(8));
        }
        parent.add(Box.createVerticalStrut(25));
    }

    // PAGE CATEGORIES (inchangée)
    private JPanel createPageCategories() {
        JPanel p = new JPanel(new GridLayout(2, 3, 20, 20));
        p.setBackground(fond);
        p.setBorder(BorderFactory.createEmptyBorder(30, 30, 30, 30));
        p.setPreferredSize(new Dimension(900, 700));

        String[] cats = {
            "LITTÉRATURE & FICTION", "HISTOIRE & CIVILISATION", "SOCIÉTÉ & FÉMINISME",
            "ARTS, MUSIQUE & CULTURE", "ENTREPRENEURIAT & LEADERSHIP", "JEUNESSE, CONTES & LÉGENDAIRES"
        };
        
        String[] imgFiles = {
            "cat_literature&fiction.png.jpg", "cat_histoire&civilisation.png.jpg", "cat_société&feminisme.png.jpg", 
            "cat_art,musique&culture.PNG.jpg", "cat_entreprenariat&leadership.png.jpg", "cat_jeunesse,conte&legende.png.jpg"
        };

        for (int i = 0; i < cats.length; i++) {
            String c = cats[i];
            JPanel card = new JPanel(new BorderLayout());
            card.setBackground(kola);
            card.setBorder(BorderFactory.createLineBorder(acacia, 1));
            
            try {
                ImageIcon catIcon = new ImageIcon(new ImageIcon("images/" + imgFiles[i])
                                     .getImage().getScaledInstance(120, 120, Image.SCALE_SMOOTH));
                JLabel imgLabel = new JLabel(catIcon);
                imgLabel.setHorizontalAlignment(SwingConstants.CENTER);
                card.add(imgLabel, BorderLayout.CENTER);
            } catch (Exception e) {
                JLabel placeholder = new JLabel("📚", SwingConstants.CENTER);
                placeholder.setFont(new Font("Serif", Font.PLAIN, 60));
                placeholder.setForeground(acacia);
                card.add(placeholder, BorderLayout.CENTER);
            }

            JLabel labelText = new JLabel("<html><center>" + c + "</center></html>", SwingConstants.CENTER);
            labelText.setFont(new Font("Serif", Font.BOLD, 12));
            labelText.setForeground(texteClair);
            card.add(labelText, BorderLayout.NORTH);

            JButton b = new JButton(t("explorer"));
            b.setBackground(argile);
            b.setForeground(Color.WHITE);
            b.setBorderPainted(false);
            b.addActionListener(e -> {
                mainContent.add(createPageDetails(c), "Cat_" + c);
                cardLayout.show(mainContent, "Cat_" + c);
            });
            card.add(b, BorderLayout.SOUTH);
            p.add(card);
        }
        return p;
    }

