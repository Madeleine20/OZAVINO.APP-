                estConnecte = false;
                nomUtilisateur = "";
                JOptionPane.showMessageDialog(p, t("deconnexion_reussie"));
                mainContent.add(createPageCompte(), "Compte");
                cardLayout.show(mainContent, "Accueil");
            }
        });
        
        buttonPanel.add(modifierBtn);
        buttonPanel.add(deconnecterBtn);
        p.add(buttonPanel);
        
        return p;
    }

